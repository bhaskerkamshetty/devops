@echo off
setlocal enabledelayedexpansion

:: ==========================================
:: Configuration
:: ==========================================
set "PREFIX=PREDEFINEDTEXT"

echo ===================================================
echo Configuring Hostname, sys_admin Account, and OOBE
echo ===================================================

:: 1. Set Hostname (PREFIX-LAST4 of Serial Number)
for /f "skip=1 delims=" %%A in ('wmic bios get serialnumber') do (
    for /f "tokens=*" %%B in ("%%A") do (
        if not defined RAW_SERIAL set "RAW_SERIAL=%%B"
    )
)

set "SERIAL=%RAW_SERIAL: =%"
set "SERIAL_LAST4=%SERIAL:~-4%"
set "NEW_HOSTNAME=%PREFIX%-%SERIAL_LAST4%"

echo Setting Computer Name to: %NEW_HOSTNAME%
wmic computersystem where name="%COMPUTERNAME%" rename "%NEW_HOSTNAME%"

:: 2. Enable Administrator, set password, and rename to sys_admin
net user Administrator Admin@123 /active:yes
net user Administrator /passwordchg:yes
wmic useraccount where name='Administrator' rename sys_admin

:: 3. Skip OOBE initial user creation and privacy screens
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE" /v "SkipMachineOOBE" /t REG_DWORD /d 1 /f
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE" /v "SkipUserOOBE" /t REG_DWORD /d 1 /f
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE" /v "HideEULAPage" /t REG_DWORD /d 1 /f
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE" /v "ProtectYourPC" /t REG_DWORD /d 3 /f

:: 4. Reboot directly to the login prompt
echo Configuration complete. Rebooting to Windows login screen...
shutdown /r /t 0
